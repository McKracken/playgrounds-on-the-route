# Copy this file to .env and fill in the values you need.
# .env is loaded automatically (python-dotenv) and is gitignored -- never commit
# your actual .env file.

# Credential for whichever provider your --vision-model uses, per litellm's
# convention -- e.g. ANTHROPIC_API_KEY for "anthropic/claude-*" models,
# OPENAI_API_KEY for "gpt-*" models, GEMINI_API_KEY for "gemini/*" models, etc.
# See https://docs.litellm.ai/docs/providers for the full list.
ANTHROPIC_API_KEY=

# Optional: default model for --vision-model so you don't have to pass the
# flag on every invocation. An explicit --vision-model on the command line
# always overrides this.
PLAYGROUND_CHECK_VISION_MODEL=anthropic/claude-haiku-4-5
